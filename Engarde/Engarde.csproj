<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Artem Ovechko</Authors>
        <PackageId>Engarde</PackageId>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <Version>1.0.0</Version>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>En garde! Prepare your code to guard against unwanted access. Put feature toggles (flags) guards anywhere in the code: class, method, property or field. Engarde compiles feature toggle names into attributes and injectable services. Reuse toggle guards configured once with Engarde. Define failed toggle check behavior globally or per flag</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- ASP.NET Core is provided by its shared framework rather than by .NET Standard. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <Compile Remove="EngardeApplicationBuilderExtensions.cs" />
    </ItemGroup>

    <!-- Builds the weaver first and ships it with the package; consumers get weaving through build/buildTransitive -->
    <ItemGroup>
        <ProjectReference Include="..\Engarde.Generators\Engarde.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\README.md" Pack="true" PackagePath="/" />
        <None Include="build\Engarde.targets" Pack="true" PackagePath="build;buildTransitive" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <ProjectReference Include="..\Engarde.Weaver\Engarde.Weaver.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <!-- Collected at pack time, after the weaver project reference is built -->
    <Target Name="IncludeWeaverInPackage" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="..\Engarde.Generators\bin\$(Configuration)\netstandard2.0\Engarde.Generators.dll"
                  Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
            <None Include="..\Engarde.Weaver\bin\$(Configuration)\net8.0\**\*" Pack="true" PackagePath="tools\weaver" Visible="false" />
        </ItemGroup>
    </Target>

</Project>
